{
  "name": "saas-project-management",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS project management platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @saas/web",
    "dev:api": "npm run dev --workspace @saas/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace @saas/web",
    "build:api": "npm run build --workspace @saas/api",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @saas/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @saas/api --",
    "prisma:studio": "npm run prisma:studio --workspace @saas/api"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
